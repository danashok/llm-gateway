# Application
PORT=8080

# Database
DB_DRIVER=postgres
DB_SOURCE=postgresql://pg_user:pg_password@localhost:5432/postgres_db?sslmode=disable

# PostgreSQL (for docker-compose)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Gateway
WORKER_POOL_SIZE=500
REQUEST_TIMEOUT=60s
SESSION_TTL=2h
DEFAULT_DAILY_BUDGET=100000

# LLM Providers - Comma-separated API keys for key rotation
# Multiple keys enable automatic rotation and rate limit handling
OPENAI_API_KEYS=
ANTHROPIC_API_KEYS=

# Legacy single-key support (deprecated, use comma-separated keys above)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Internal model endpoint
INTERNAL_MODEL_URL=http://internal-llm:8000
